#!/bin/bash

# Stage 2 (Stats Collection) + Stage 3 (Charge Quantification) + Stage 5 (QC)
# Aggregation step — processes ALL samples together.
# Reads per-sample alignment JSONs, computes stats, charge, and QC report.

#SBATCH --cpus-per-task=16
#SBATCH -p short
#SBATCH -t 12:00:00
#SBATCH --mem=32G
#SBATCH --mail-type=BEGIN,END,FAIL
#SBATCH --mail-user=russel_vincent@hms.harvard.edu
#SBATCH --job-name=tseq-235
#SBATCH -o /home/ruv988/jobOutput/tseq-235_%j.out
#SBATCH -e /home/ruv988/jobOutput/tseq-235_%j.err

set -euo pipefail

CONFIG="$1"
PROJECT_DIR="$2"

echo "=== tRNA-charge-seq: Stage 2 + 3 + 5 ==="
echo "Config:  $CONFIG"
echo "Project: $PROJECT_DIR"
echo "Node:    $(hostname)"
echo "CPUs:    ${SLURM_CPUS_PER_TASK:-16}"
echo "Start:   $(date)"
echo ""

# Load modules and activate conda environment
module load conda/miniforge3/24.11.3-0
conda activate tRNA-seq

python -m trnaseq pipeline \
    --config "$CONFIG" \
    --project-dir "$PROJECT_DIR" \
    --n-jobs "${SLURM_CPUS_PER_TASK:-16}" \
    --stages 2,3,5

if [ $? -ne 0 ]; then
    echo "Error: Stages 2+3+5 failed" >&2
    exit 1
fi

echo ""
echo "Done: $(date)"
