#!/bin/bash

# Stage 0a (Adapter Removal + Merging) + Stage 0b (Barcode Splitting)
# Processes ALL input file pairs — not per-sample.
# Typically fast: ~5 min for 8 samples, ~35 min for 256 samples.

#SBATCH --cpus-per-task=4
#SBATCH -p short
#SBATCH -t 01:00:00
#SBATCH --mem=16G
#SBATCH --mail-type=BEGIN,END,FAIL
#SBATCH --mail-user=russel_vincent@hms.harvard.edu
#SBATCH --job-name=tseq-0ab
#SBATCH -o /home/ruv988/jobOutput/tseq-0ab_%j.out
#SBATCH -e /home/ruv988/jobOutput/tseq-0ab_%j.err

set -euo pipefail

CONFIG="$1"
PROJECT_DIR="$2"
THREADS_PER_JOB="${3:-2}"

CPUS="${SLURM_CPUS_PER_TASK:-4}"
N_JOBS=$(( CPUS / THREADS_PER_JOB ))
# Ensure at least 1 job
N_JOBS=$(( N_JOBS > 0 ? N_JOBS : 1 ))

echo "=== tRNA-charge-seq: Stage 0a + 0b ==="
echo "Config:  $CONFIG"
echo "Project: $PROJECT_DIR"
echo "Node:    $(hostname)"
echo "CPUs:    $CPUS  (${N_JOBS} jobs × ${THREADS_PER_JOB} threads)"
echo "Start:   $(date)"
echo ""

# Load modules and activate conda environment
module load conda/miniforge3/24.11.3-0
conda activate tRNA-seq

python -m trnaseq pipeline \
    --config "$CONFIG" \
    --project-dir "$PROJECT_DIR" \
    --n-jobs "$N_JOBS" \
    --threads-per-job "$THREADS_PER_JOB" \
    --stages 0a,0b

if [ $? -ne 0 ]; then
    echo "Error: Stages 0a+0b failed" >&2
    exit 1
fi

echo ""
echo "Done: $(date)"
