#!/bin/bash

# Stage 0c (UMI Trimming) + Stage 1 (SWIPE Alignment) — per sample
# Uses SLURM_ARRAY_TASK_ID as --sample-index.
# Each array task processes ONE sample independently.

#SBATCH --cpus-per-task=4
#SBATCH -p short
#SBATCH -t 12:00:00
#SBATCH --mem=8G
#SBATCH --mail-type=BEGIN,END,FAIL
#SBATCH --mail-user=russel_vincent@hms.harvard.edu
#SBATCH --job-name=tseq-0c1
#SBATCH -o /home/ruv988/jobOutput/tseq-0c1_%A_%a.out
#SBATCH -e /home/ruv988/jobOutput/tseq-0c1_%A_%a.err

set -euo pipefail

CONFIG="$1"
PROJECT_DIR="$2"
SAMPLE_IDX="${SLURM_ARRAY_TASK_ID}"

CPUS="${SLURM_CPUS_PER_TASK:-4}"

echo "=== tRNA-charge-seq: Stage 0c + 1 (sample ${SAMPLE_IDX}) ==="
echo "Config:  $CONFIG"
echo "Project: $PROJECT_DIR"
echo "Node:    $(hostname)"
echo "CPUs:    $CPUS  (1 job × ${CPUS} threads for SWIPE)"
echo "Start:   $(date)"
echo ""

# Load modules and activate conda environment
module load conda/miniforge3/24.11.3-0
conda activate tRNA-seq

# Single sample: 1 job with all CPUs as threads for SWIPE alignment
python -m trnaseq pipeline \
    --config "$CONFIG" \
    --project-dir "$PROJECT_DIR" \
    --n-jobs 1 \
    --threads-per-job "$CPUS" \
    --stages 0c,1 \
    --sample-index "$SAMPLE_IDX"

if [ $? -ne 0 ]; then
    echo "Error: Stages 0c+1 failed for sample ${SAMPLE_IDX}" >&2
    exit 1
fi

echo ""
echo "Done: $(date)"
