#!/bin/bash

# Stage 2 (Stats) + 3 (Charge) + 4 (Parquet) + 5 (QC) + 6 (Mods) + 7 (Abundance)
# Aggregation step — processes ALL samples together.
# Reads per-sample alignment JSONs, computes stats, charge, parquet mirrors,
# QC report, modifications + crosstalk, and abundance.

#SBATCH --cpus-per-task=16
#SBATCH -p short
#SBATCH -t 12:00:00
#SBATCH --mem=32G
#SBATCH --mail-type=BEGIN,END,FAIL
#SBATCH --mail-user=russel_vincent@hms.harvard.edu
#SBATCH --job-name=tseq-2356
#SBATCH -o /home/ruv988/jobOutput/tseq-2356_%j.out
#SBATCH -e /home/ruv988/jobOutput/tseq-2356_%j.err

set -euo pipefail

CONFIG="$1"
PROJECT_DIR="$2"

echo "=== tRNA-charge-seq: Stage 2 + 3 + 4 + 5 + 6 + 7 ==="
echo "Config:  $CONFIG"
echo "Project: $PROJECT_DIR"
echo "Node:    $(hostname)"
echo "CPUs:    ${SLURM_CPUS_PER_TASK:-16}"
echo "Start:   $(date)"
echo ""

# Load modules and activate conda environment
module load conda/miniforge3/24.11.3-0
conda activate tRNA-seq
export LD_PRELOAD=$CONDA_PREFIX/lib/libstdc++.so.6 

python -m trnaseq pipeline \
    --config "$CONFIG" \
    --project-dir "$PROJECT_DIR" \
    --n-jobs "${SLURM_CPUS_PER_TASK:-16}" \
    --stages 2,3,4,5,6,7

if [ $? -ne 0 ]; then
    echo "Error: Stages 2+3+4+5+6+7 failed" >&2
    exit 1
fi

echo ""
echo "Done: $(date)"
